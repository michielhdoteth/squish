# Files to exclude from npm package
node_modules/
.github/
.vscode/
.idea/

# Documentation (users can read README/CHANGELOG online)
docs/
*.md
!README.md
!CHANGELOG.md
!LICENSE
!QUICK-START.md

# Infrastructure
infra/
tests/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Logs
*.log
npm-debug.log*
squish.log
squish-test.log

# Environment
.env*

# Temporary/cache
*.tmp
.cache/
coverage/
.nyc_output/
.DS_Store
Thumbs.db

# Package manager lock files (npm handles this)
bun.lock
bun.lockb
package-lock.json
yarn.lock

# Build artifacts (already included via dist/)
*.tgz
*.tar.gz

# Development only
features/
benchmark/
.sisyphus/
references/
opencode/

# Squish runtime data
.squish/
*.db
*.db-journal

# Generated files during development
generated/
squish-*.tgz
nul
NUL

# TypeScript source (only ship dist/)
src/
tsconfig.json
tsconfig.*.json
