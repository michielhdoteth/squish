{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Squish MCP Universal Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "servers"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["transport", "command", "args", "env"],
        "properties": {
          "transport": {
            "type": "string",
            "enum": ["stdio", "http", "sse"]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
