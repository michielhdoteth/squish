{
  "methods": [
    "oauth",
    "token"
  ],
  "defaultMethod": "token",
  "precedence": [
    "token",
    "oauth"
  ],
  "token": {
    "requiredEnv": [
      "SQUISH_REMOTE_TOKEN"
    ],
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "oauth": {
    "pkce": true,
    "deviceCode": true,
    "authorizationUrlEnv": "SQUISH_OAUTH_AUTH_URL",
    "tokenUrlEnv": "SQUISH_OAUTH_TOKEN_URL",
    "clientIdEnv": "SQUISH_OAUTH_CLIENT_ID"
  },
  "cli": {
    "openclaw": {
      "default": "token"
    },
    "claude-code": {
      "default": "token"
    },
    "opencode": {
      "default": "token"
    }
  }
}
