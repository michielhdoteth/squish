{
  "version": 1,
  "mode": "remote",
  "tenancy": {
    "isolation": "project-and-user",
    "defaultVisibility": "private",
    "allowedVisibility": ["private", "project", "global"]
  },
  "retention": {
    "hotDays": 30,
    "warmDays": 180,
    "coldArchiveDays": 730
  },
  "search": {
    "hybrid": true,
    "bm25": true,
    "semantic": true,
    "defaultLimit": 10,
    "maxLimit": 50
  },
  "governance": {
    "secretFiltering": true,
    "mergeReviewRequired": true,
    "auditSnapshots": true
  },
  "auth": {
    "primary": "token",
    "secondary": "oauth",
    "requiredEnv": ["SQUISH_REMOTE_TOKEN"]
  },
  "requiredEnv": ["DATABASE_URL", "REDIS_URL", "SQUISH_REMOTE_TOKEN"]
}
