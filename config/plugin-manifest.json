{
  "id": "squish-memory",
  "name": "Squish Memory",
  "version": "1.1.0",
  "description": "Universal two-tier memory system for AI agents with hybrid search, core memory, and MCP-first architecture",
  "capabilities": ["mcp", "cli", "web"],
  "targets": {
    "claude-code": {
      "type": "mcp",
      "configFile": "~/.claude/mcp.json",
      "format": "standard",
      "serverName": "squish",
      "command": "npx",
      "args": ["-y", "squish-memory", "--stdio"],
      "env": {}
    },
    "opencode": {
      "type": "mcp",
      "configFile": "~/.config/opencode/mcp-servers.json",
      "format": "opencode",
      "serverName": "squish-memory",
      "command": ["npx", "-y", "squish-memory"],
      "enabled": true
    },
    "codex": {
      "type": "mcp",
      "configFile": "~/.codex/mcp-servers.json",
      "format": "standard",
      "serverName": "squish",
      "command": "npx",
      "args": ["-y", "squish-memory", "--stdio"],
      "env": {}
    },
    "cursor": {
      "type": "mcp",
      "configFile": "~/.cursor/mcp.json",
      "format": "standard",
      "serverName": "squish",
      "command": "npx",
      "args": ["-y", "squish-memory", "--stdio"],
      "env": {}
    },
    "vscode": {
      "type": "mcp",
      "configFile": "~/.vscode/mcp/servers.json",
      "format": "standard",
      "serverName": "squish",
      "command": "npx",
      "args": ["-y", "squish-memory", "--stdio"],
      "env": {}
    },
    "windsurf": {
      "type": "mcp",
      "configFile": "~/.windsurf/mcp-servers.json",
      "format": "standard",
      "serverName": "squish",
      "command": "npx",
      "args": ["-y", "squish-memory", "--stdio"],
      "env": {}
    }
  },
  "dependencies": {
    "@tobilu/qmd": {
      "version": "2.0.1",
      "autoInstall": true,
      "optional": false,
      "provides": ["fast-search", "bm25", "vector-search"]
    }
  },
  "auth": {
    "modes": ["none", "token"],
    "default": "none",
    "token": {
      "envVar": "SQUISH_REMOTE_TOKEN",
      "help": "Set SQUISH_REMOTE_TOKEN for remote mode authentication"
    }
  },
  "pinning": {
    "@tobilu/qmd": "2.0.1",
    "@modelcontextprotocol/sdk": "1.27.1"
  },
   "entry": {
     "mcp": "dist/core/commands/mcp-server.js",
     "cli": "dist/index.js"
   },
  "compatibility": {
    "minNodeVersion": "18.0.0",
    "clients": [
      { "id": "claude-code", "minVersion": "0.62.0" },
      { "id": "opencode", "minVersion": "0.1.0" },
      { "id": "codex", "minVersion": "0.1.0" },
      { "id": "cursor", "minVersion": "0.45.0" },
      { "id": "vscode-mcp", "minVersion": "1.0.0" },
      { "id": "windsurf", "minVersion": "0.1.0" }
    ]
  },
  "healthCheck": {
    "mcpTool": "squish_health",
    "httpEndpoint": "/health"
  }
}
