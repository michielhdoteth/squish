# Squish Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# MODE (always local)
# =============================================================================
SQUISH_MODE=local

# =============================================================================
# SQLITE DRIVER FALLBACK (data-safety)
# =============================================================================
# If no native SQLite driver (bun:sqlite / better-sqlite3) can load, Squish
# falls back to sql.js, which REWRITES THE ENTIRE DATABASE FILE ON EVERY
# WRITE. Concurrent processes will lose data or corrupt the DB. The fallback
# is allowed by default with a loud warning (single-process use); set the
# flag below to false to fail startup instead.
# SQUISH_ALLOW_SQLJS_FALLBACK=false

# =============================================================================
# LOCAL MODE DATA DIRECTORY
# =============================================================================
# A leading ~/ is expanded to your home directory. All MCP clients share the
# default ~/.squish unless explicitly overridden here.
SQUISH_DATA_DIR=./.squish

# =============================================================================
# MCP SERVER
# =============================================================================
SQUISH_MCP_PORT=8767
SQUISH_MCP_SERVER_ENABLED=false

# CORS (comma-separated origins, * wildcard for port)
# SQUISH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8080

# =============================================================================
# EMBEDDINGS PROVIDER
# =============================================================================
# Options: local | openai | ollama | google | none | auto
# local = TF-IDF instantly at boot, then a real bundled model (all-MiniLM-L6-v2)
#         loads in the background and takes over. No API key needed.
# auto  = Try OpenAI > Ollama > Google > local fallback
SQUISH_EMBEDDINGS_PROVIDER=local

# Bundled local model loaded in the background by the "local" provider.
# Set to off to pin deterministic TF-IDF (offline evals, CI).
# SQUISH_LOCAL_BUNDLED_MODEL=Xenova/all-MiniLM-L6-v2
# SQUISH_LOCAL_BUNDLED_DTYPE=q8

# Vector scan candidate selection: full-corpus chunked scan or recency window.
# full scans every candidate row (complete recall); recency only sees the
# newest ~200 rows. Benchmark: scripts/bench-vector-scan.ts
# SQUISH_VECTOR_SCAN=full

# OpenAI (example: set both key and model)
# SQUISH_OPENAI_API_KEY=sk-...
# SQUISH_OPENAI_API_URL=https://api.openai.com/v1/embeddings
# SQUISH_OPENAI_EMBEDDING_MODEL=<openai-embedding-model>

# Ollama (example: set URL and model served by your local Ollama)
# SQUISH_OLLAMA_URL=http://localhost:11434
# SQUISH_OLLAMA_EMBEDDING_MODEL=<ollama-embedding-model>

# LM Studio (example: set URL and model loaded in LM Studio)
# SQUISH_LM_STUDIO_URL=http://localhost:1234
# SQUISH_LM_STUDIO_EMBEDDING_MODEL=<lm-studio-embedding-model>

# Transformers.js local (example: set a Hugging Face ONNX embedding model)
# SQUISH_LOCAL_MODEL=<huggingface-onnx-embedding-model>

# Google Cloud
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_API_KEY=your-api-key
# Or use service account:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# SQUISH_GOOGLE_EMBEDDING_MODEL=<google-embedding-model>

# Embedding reliability
SQUISH_EMBEDDINGS_TIMEOUT_MS=30000
SQUISH_EMBEDDINGS_MAX_RETRIES=3
SQUISH_EMBEDDINGS_RETRY_DELAY_MS=1000

# Optional LLM graph enrichment (off by default for launch-safe local mode)
SQUISH_LLM_ENABLED=false
# SQUISH_LLM_PROVIDER=openai
# SQUISH_LLM_ENDPOINT=http://localhost:1234
# SQUISH_LLM_EXTRACTION_MODEL=<llm-extraction-model>
# SQUISH_LLM_REASONING_MODEL=<llm-reasoning-model>

# =============================================================================
# QMD (local markdown search)
# =============================================================================
SQUISH_QMD_ENABLED=false
# SQUISH_QMD_COLLECTIONS=./qmd-collections
# SQUISH_QMD_FALLBACK=hybrid

# =============================================================================
# LIFECYCLE & MEMORY
# =============================================================================
SQUISH_LIFECYCLE_ENABLED=true
SQUISH_SUMMARIZATION_ENABLED=true
SQUISH_GOVERNANCE_ENABLED=true

# Memory tier decay (v1.1.0+)
# Threshold for tier demotion: memories below this score get demoted (default: 0.1)
# SQUISH_DECAY_THRESHOLD=0.1
# Decay job cron schedule (default: hourly)
# SQUISH_LIFECYCLE_DECAY_CRON=0 * * * *

# =============================================================================
# ENCRYPTION (v1.1.0+)
# =============================================================================
# Client-side AES-256-GCM encryption for memory content
# Set passphrase to enable encryption (requires existing memories to be re-encrypted)
# SQUISH_ENCRYPTION_PASSPHRASE=your-secure-passphrase

# Core memory limits (v0.9.2+)
# SQUISH_CORE_MEMORY_TOTAL_BYTES=16384
# SQUISH_CORE_MEMORY_SECTION_BYTES=4096

# =============================================================================
# GRAPH BOOST (v1.1.0+)
# =============================================================================
# Scoring weight for graph boost in recall (default: 1.5)
# Higher = more influence from memory associations
# SQUISH_WEIGHT_GRAPH_BOOST=1.5
# SQUISH_GRAPH_AUTO_BUILD=true
# SQUISH_GRAPH_EXTRACTION_METHOD=auto

# =============================================================================
# MANAGED MODE (Squish Cloud - paid tier)
# =============================================================================
# When enabled, MCP tools send memories directly to the cloud API.
# SQUISH_MANAGED_MODE=false
# SQUISH_MANAGED_API_URL=https://api.squish.dev
# SQUISH_MANAGED_API_KEY=your-api-key

# =============================================================================
# MCP HTTP AUTH (v1.3.0+)
# =============================================================================
# Set a key to require authentication for HTTP mode connections.
# SQUISH_MCP_API_KEY=your-mcp-api-key

# =============================================================================
# GRAPH HTML EXPORT (v1.3.0+)
# =============================================================================
# Auto-generates .squish/graph.html on graph builds (for non-Obsidian users)
# SQUISH_GRAPH_AUTO_EXPORT=false

# =============================================================================
# OPENCLAW GATEWAY
# =============================================================================
OPENCLAW_GATEWAY_ENABLED=false

# =============================================================================
# RETRIEVAL PRECISION STACK (Batches 0-5)
# =============================================================================
# Each flag is individually disableable with false/0/no/off.
# Cross-encoder rerank: ON by default, degrades gracefully when the model
# cannot load (timeout-capped).
# SQUISH_RERANKER_ENABLED=true
# SQUISH_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# SQUISH_RERANKER_LOAD_TIMEOUT_MS=10000
# SQUISH_RERANKER_TOP_K=20
# SQUISH_RERANKER_RETURN_TOP_K=10

# Query expansion: ON by default.
# SQUISH_QUERY_EXPANSION=true

# Temporal validity: OFF by default - the golden-eval gate showed a recall
# breach when enabled (flat staleness penalty is too blunt on aged corpora).
# Opt in explicitly.
# SQUISH_TEMPORAL_VALIDITY=false

# MMR diversity re-ranking.
# SQUISH_MMR_ENABLED=true
# SQUISH_MMR_LAMBDA=0.7
# SQUISH_MMR_TOP_K=10
# SQUISH_MMR_CANDIDATE_POOL=50

# Contextual retrieval prefixes and entity-aware retrieval.
# SQUISH_CONTEXTUAL_RETRIEVAL=true
# SQUISH_CONTEXTUAL_PREFIX_TEMPLATE=<your-template>
# SQUISH_ENTITY_RETRIEVAL=true

# Graph boost serving mode: legacy flat boost vs normalized neighbor walk.
# SQUISH_GRAPH_BOOST_LEGACY=false
# SQUISH_GRAPH_NEIGHBOR_BOOST=0.15

# =============================================================================
# SCORING V2 + RECALL CONFIDENCE (Batch 6a)
# =============================================================================
# Serve v2 composite ranking; shadow mode logs v2 alongside without serving.
SQUISH_SCORING_V2=true
# SQUISH_SCORING_SHADOW=false

# Recall-confidence floor. When set, recall results whose best confidence is
# below the threshold get an honest no_reliable_memory verdict instead of
# weak hits (selective recall). Unset = always return best effort.
# SQUISH_ABSTAIN_BELOW=0.55

# Search beliefs alongside memories in hybrid retrieval.
SQUISH_SEARCH_BELIEFS=true

# Superseded handling in retrieval.
# SQUISH_INCLUDE_SUPERSEDED=true
# SQUISH_SUPERSEDED_PENALTY=0.5

# =============================================================================
# SECTORS, DECAY ENGINE, TIERS (Batch 6b)
# =============================================================================
# Signals-based sector routing (episodic|semantic|procedural|reflective) is
# automatic. One-time backfill of historical rows:
# SQUISH_SECTOR_BACKFILL_DRY_RUN=true

# Ebbinghaus decay engine (replaces sector-based decay).
# SQUISH_DECAY_ENGINE=v2

# =============================================================================
# ENGINE GENERATION FLAGS (Batch 5/6 - dual-run adoption)
# =============================================================================
# Contradiction engine generation: v1 (heuristic, default) | v2 (stub).
# SQUISH_CONTRADICTION_ENGINE=v1
# Shadow mode: run both, log disagreements, serve v1.
# SQUISH_CONTRADICTION_SHADOW=true
# Importance engine generation: v1 (usage-based, default) | v2 (surprise/emotion).
# SQUISH_IMPORTANCE_ENGINE=v1
# SQUISH_IMPORTANCE_SHADOW=true

# Tier maintenance thresholds.
# SQUISH_DECAY_HOT_TIER_DAYS=7
# SQUISH_DECAY_COLD_TIER_DAYS=90

# =============================================================================
# FEEDBACK / REINFORCEMENT LOOP (Batch 6b)
# =============================================================================
# squish_feedback signals (confirm/used/contradict) adjust these echoes.
# SQUISH_FEEDBACK_TRACKING=true
# SQUISH_FEEDBACK_ECHO_BONUS=10
# SQUISH_FEEDBACK_FIZZLE_PENALTY=10

# =============================================================================
# DEDUP / MERGE WORKFLOW (Batch 6b)
# =============================================================================
# Nightly dedup_maintenance creates merge proposals for review via
# squish_dedup. Auto-execution of high-threshold merges is strictly gated
# (threshold and per-run cap are set on the dedup_maintenance job config).
SQUISH_DEDUP_AUTO=false

# =============================================================================
# ACL / VISIBILITY ENFORCEMENT (Batch 6b)
# =============================================================================
# Enforce visibility rules on memory reads (default: advisory only).
SQUISH_ACL_ENFORCE=false

# =============================================================================
# GEOMETRY-AWARE CONSOLIDATION (GAC)
# =============================================================================
# d_bar/d_eff geometry guards around cluster consolidation.
SQUISH_GEOMETRY_CONSOLIDATION=true
# SQUISH_GEOMETRY_THETA_PRIME=0.15
# SQUISH_GEOMETRY_AUTO_CONSOLIDATE=true
# SQUISH_GEOMETRY_AUTO_SPLIT=true
# SQUISH_GEOMETRY_MIN_CLUSTER_SIZE=3
# SQUISH_GEOMETRY_PRESERVE_PINNED=true

# =============================================================================
# WIKI -> MEMORY ONE-TIME MIGRATION (Batch 8)
# =============================================================================
# The wiki subsystem was removed (db-only memory). On first boot after
# upgrade, legacy wiki_pages rows are migrated into memories tagged
# wiki-origin; resolvable [[wikilinks]] become graph associations; legacy
# tables are dropped. Set to true to preview counts without writing.
# SQUISH_WIKI_MIGRATE_DRY_RUN=true

# =============================================================================
# MAINTENANCE TOOL GATE
# =============================================================================
# Expose the squish_maintenance MCP tool (default off).
# SQUISH_ENABLE_MAINTENANCE_TOOLS=true
