    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.cjs",
    "dist/**/*.wasm",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "scripts",
