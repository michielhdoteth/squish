{
  "name": "squish-memory",
  "version": "1.0.0",
  "description": "Universal plugin architecture memory system - works as plugin across Claude Code, OpenClaw, OpenCode, Codex, Cursor, VSCode, Windsurf. MCP server with CLI fallback, QMD search, and two-tier storage.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "squish": "dist/index.js",
    "squish-mcp": "dist/commands/mcp-server.cjs",
    "squish-install": "npx-installer.js",
    "squish-install-plugin": "scripts/install-plugin.mjs"
  },
  "scripts": {
    "build": "tsc",
    "build:plugins": "npm run build && npm run build:claude && npm run build:openclaw && npm run build:mcp",
    "build:claude": "cp -r .claude-plugin packages/plugin-claude-code/",
    "build:openclaw": "mkdir -p packages/plugin-openclaw/dist && cp -r plugins/openclaw/* packages/plugin-openclaw/ && (cd packages/plugin-openclaw && npm run build 2>/dev/null || true)",
    "build:mcp": "cp -r generated/mcp packages/plugin-mcp/",
    "mcp:build": "tsc commands/mcp-server.ts --outDir dist/commands --module ES2022 --moduleResolution node --esModuleInterop --target ES2022 --skipLibCheck",
    "mcp:cjs": "esbuild commands/mcp-server.ts --bundle --platform=node --outfile=dist/commands/mcp-server.cjs --format=cjs --external:bun:* --external:better-sqlite3 --external:pg --external:drizzle-orm/*",
    "start": "node dist/index.js",
    "mcp": "node dist/commands/mcp-server.cjs",
    "web": "node dist/api/web/web-server.js",
    "web:bun": "bun run dist/api/web/web-server.js",
    "dev": "bun --hot src/index.ts",
    "dev:mcp": "bun --hot src/commands/mcp-server.ts",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "preflight:remote": "node scripts/remote-preflight.mjs",
    "fallback:dry": "node scripts/squish-fallback.mjs --op health --simulate-mcp-failure --dry-run",
    "deps:check": "node scripts/dependency-manager.mjs",
    "deps:install": "node scripts/dependency-manager.mjs",
    "detect:clients": "node scripts/detect-clients.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test": "node --test dist/tests/**/*.test.js",
    "clean": "rm -rf dist && rm -f *.log",
    "bench": "bun benchmark/memory.ts",
    "bench:db": "bun benchmark/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "npm run build",
    "postinstall": "node scripts/init-dirs.mjs",
    "release": "./scripts/build-release.sh && ./scripts/github-release.sh",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michielhdoteth/squish.git"
  },
  "homepage": "https://github.com/michielhdoteth/squish#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/michielhdoteth"
  },
  "bugs": {
    "url": "https://github.com/michielhdoteth/squish/issues"
  },
  "keywords": [
    "ai-agent",
    "memory",
    "persistent-memory",
    "universal-memory",
    "mcp-server",
    "mcp-client",
    "model-context-protocol",
    "claude-code",
    "openclaw",
    "opencode",
    "codex",
    "cursor",
    "windsurf",
    "vscode",
    "plugin",
    "plugin-architecture",
    "openclaw-plugin",
    "claude-code-plugin",
    "qmd",
    "sqlite",
    "postgres",
    "hybrid-search",
    "context-management",
    "semantic-search",
    "local-first",
    "privacy",
    "agent-framework",
    "agent-memory"
  ],
   "files": [
      "dist",
      "scripts",
      "commands",
      "skills",
      "hooks",
      "config",
      "bin",
      "generated",
      "packages",
      "plugin.json",
      ".claude-plugin",
      ".mcp.json",
      ".env.mcp.example",
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "QUICK-START.md"
    ],
  "author": "michielhdoteth",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "better-sqlite3": "12.6.2",
    "bull": "^4.16.0",
    "commander": "^12.0.0",
    "cors": "2.8.6",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0",
    "pg": "8.19.0",
    "pgvector": "^0.2.0",
    "redis": "^4.7.0",
    "tree-sitter": "^0.22.0",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-python": "^0.23.0",
    "tree-sitter-typescript": "^0.23.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.0",
    "pkg": "^5.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.17"
  }
}
