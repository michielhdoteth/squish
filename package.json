    "db",
    "plugin",
    "!plugin/**/db/**",
    "packages",
    "!packages/**/*.test.ts",
    "!packages/**/*.test.js",
    "webui",
    "generated",
    "mcp.json.example",
    ".env.example",
    "LICENSE",
