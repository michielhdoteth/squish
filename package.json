{
  "name": "@squish/memory",
  "version": "1.1.5",
  "description": "Two-tier memory for AI agents: QMD-based fast file search (short-term) + SQLite/Postgres (long-term). Works out-of-the-box, no setup required.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "squish": "dist/index.js",
    "squish-mcp": "dist/core/commands/mcp-server.js",
    "squish-add": "bin/squish-add.mjs",
    "squish-rm": "bin/squish-rm.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/index.js",
    "mcp": "node dist/core/commands/mcp-server.js",
    "dev": "bun --hot index.ts",
    "dev:mcp": "bun --hot core/commands/mcp-server.ts",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "preflight:remote": "node scripts/remote-preflight.mjs",
    "fallback:dry": "node scripts/squish-fallback.mjs --op health --simulate-mcp-failure --dry-run",
    "deps:check": "node scripts/dependency-manager.mjs",
    "deps:install": "node scripts/dependency-manager.mjs",
    "detect:clients": "node scripts/detect-clients.mjs",
    "install": "node scripts/install-interactive.mjs",
    "test:interactive": "node scripts/test-interactive.mjs",
    "test": "node --test dist/tests/**/*.test.js",
    "clean": "rm -rf dist && rm -f *.log",
    "bench": "bun benchmark/memory.ts",
    "bench:db": "bun benchmark/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepublishOnly": "npm run clean && npm run build",
    "prepare": "husky",
    "postinstall": "node scripts/init-dirs.mjs",
    "release": "./scripts/build-release.sh && ./scripts/github-release.sh",
    "check:secrets": "node scripts/check-secrets.js",
    "dev:db:init": "node dev-scripts/db/init-db.mjs",
    "dev:db:check": "node dev-scripts/db/check-db.mjs",
    "dev:db:recreate": "node dev-scripts/db/recreate-db.mjs",
    "dev:db:fix": "node dev-scripts/db/fix-schema.mjs",
    "dev:db:fix-full": "node dev-scripts/db/fix-schema-full.mjs",
    "dev:db:fix-all": "node dev-scripts/db/fix-schema-all.mjs",
    "dev:db:fix-columns": "node dev-scripts/db/fix-all-columns.mjs",
    "dev:migrate": "bun dev-scripts/migrate.ts",
    "dev:start": "dev-scripts/start.bat"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michielhdoteth/squish.git"
  },
  "homepage": "https://github.com/michielhdoteth/squish#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/michielhdoteth"
  },
  "bugs": {
    "url": "https://github.com/michielhdoteth/squish/issues"
  },
  "keywords": [
    "ai-agent",
    "memory",
    "persistent-memory",
    "universal-memory",
    "mcp-server",
    "mcp-client",
    "model-context-protocol",
    "claude-code",
    "openclaw",
    "opencode",
    "codex",
    "cursor",
    "windsurf",
    "vscode",
    "plugin",
    "plugin-architecture",
    "qmd",
    "sqlite",
    "postgres",
    "hybrid-search",
    "context-management",
    "semantic-search",
    "local-first",
    "privacy",
    "agent-framework",
    "agent-memory",
    "ai-memory",
    "agentic",
    "context-window",
    "long-term-memory",
    "rag",
    "vector-embeddings",
    "session-persistence"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.cjs",
    "dist/**/*.wasm",
    "scripts",
    "!scripts/init-dirs.ts",
    "skills",
    "hooks",
    "config",
    "bin",
    "generated",
    "mcp.json.example",
    ".env.example",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "core/commands/context-paging.md",
    "core/commands/context-status.md",
    "core/commands/context.md",
    "core/commands/core-memory.md",
    "core/commands/health.md",
    "core/commands/init.md",
    "core/commands/merge.md",
    "core/commands/recall.md",
    "core/commands/remember.md",
    "core/commands/search.md"
  ],
  "author": "michielhdoteth <michiel@4mlabs.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.0.2",
    "better-sqlite3": "12.9.0",
    "bull": "^4.16.0",
    "commander": "^14.0.3",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "hono": "^4.12.12",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pgvector": "^0.2.0",
    "picocolors": "^1.0.0",
    "redis": "^5.11.0",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "pkg": "^5.8.1",
    "typescript": "^6.0.2"
  }
}
