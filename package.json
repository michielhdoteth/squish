{
  "name": "@squish/memory",
  "version": "1.1.6",
  "description": "Two-tier memory for AI agents: QMD-based fast file search (short-term) + SQLite/Postgres (long-term). Works out-of-the-box, no setup required.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "squish": "bin/squish.mjs",
    "squish-mcp": "bin/squish-mcp.mjs",
    "squish-add": "bin/squish-add.mjs",
    "squish-rm": "bin/squish-rm.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist && rm -f *.log",
    "build": "echo 'No build needed - runs with bun or npx tsx'",
    "start": "bun run core/index.ts 2>/dev/null || npx tsx core/index.ts",
    "mcp": "bun run core/commands/mcp-server.ts 2>/dev/null || npx tsx core/commands/mcp-server.ts",
    "dev": "bun --hot core/index.ts 2>/dev/null || npx tsx --watch core/index.ts",
    "dev:mcp": "bun --hot core/commands/mcp-server.ts 2>/dev/null || npx tsx --watch core/commands/mcp-server.ts",
    "test": "bun test ./tests/ 2>/dev/null || npx vitest",
    "bench": "bun benchmark/memory.ts 2>/dev/null || npx tsx --cwd . benchmark/memory.ts",
    "bench:db": "bun benchmark/run.ts 2>/dev/null || npx tsx --cwd . benchmark/run.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michielhdoteth/squish.git"
  },
  "homepage": "https://github.com/michielhdoteth/squish#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/michielhdoteth"
  },
  "bugs": {
    "url": "https://github.com/michielhdoteth/squish/issues"
  },
  "keywords": [
    "ai-agent",
    "memory",
    "persistent-memory",
    "universal-memory",
    "mcp-server",
    "mcp-client",
    "model-context-protocol",
    "claude-code",
    "openclaw",
    "opencode",
    "codex",
    "cursor",
    "windsurf",
    "vscode",
    "plugin",
    "plugin-architecture",
    "qmd",
    "sqlite",
    "postgres",
    "hybrid-search",
    "context-management",
    "semantic-search",
    "local-first",
    "privacy",
    "agent-framework",
    "agent-memory",
    "ai-memory",
    "agentic",
    "context-window",
    "long-term-memory",
    "rag",
    "vector-embeddings",
    "session-persistence"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.cjs",
    "dist/**/*.wasm",
    "scripts",
    "!scripts/init-dirs.ts",
    "skills",
    "hooks",
    "config",
    "bin",
    "generated",
    "mcp.json.example",
    ".env.example",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "core/commands/context-paging.md",
    "core/commands/context-status.md",
    "core/commands/context.md",
    "core/commands/core-memory.md",
    "core/commands/health.md",
    "core/commands/init.md",
    "core/commands/merge.md",
    "core/commands/recall.md",
    "core/commands/remember.md",
    "core/commands/search.md"
  ],
  "author": "michielhdoteth <michiel@4mlabs.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.0.2",
    "better-sqlite3": "12.9.0",
    "commander": "^14.0.3",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pgvector": "^0.2.0",
    "redis": "^5.11.0",
    "sql.js": "^1.14.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "picocolors": "^1.0.0",
    "pkg": "^5.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  }
}
