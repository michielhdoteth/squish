# Remote mode (PostgreSQL + Redis)
DATABASE_URL=postgres://squish:squish_dev@localhost:5432/squish
REDIS_URL=redis://localhost:6379

# Embeddings
SQUISH_EMBEDDINGS_PROVIDER=openai
SQUISH_OPENAI_API_KEY=
# SQUISH_OLLAMA_URL=http://localhost:11434

# Remote auth: token primary, oauth optional
SQUISH_REMOTE_TOKEN=
# SQUISH_OAUTH_AUTH_URL=
# SQUISH_OAUTH_TOKEN_URL=
# SQUISH_OAUTH_CLIENT_ID=

OPENCLAW_GATEWAY_ENABLED=false
