# API Keys for Judges (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Squish Configuration
SQUISH_API_URL=http://localhost:3000
SQUISH_API_KEY=optional

# Benchmark Configuration
BENCHMARK_DATA_DIR=./data/benchmarks
RUNS_DIR=./data/runs
DEFAULT_JUDGE=gpt-4o
DEFAULT_ANSWERING_MODEL=gpt-4o

# Optional: Debug mode
DEBUG=false
