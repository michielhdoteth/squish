{
  "mcpServers": {
    "squish": {
      "command": "node",
      "args": ["./dist/index.js"],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "SQUISH_MODE": "local",
        "NODE_ENV": "production",
        "SQUISH_DATA_DIR": "${CLAUDE_WORKING_DIRECTORY}/.squish"
      }
    }
  }
}
