{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You have long-term memory from Squish. These are recent memories from your sessions:\n\n{{SQUISH_CONTEXT}}\n\nUse these to maintain continuity with past work."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_DIR}}/save-hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_DIR}}/precompact-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}