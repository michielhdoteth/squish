{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You have long-term memory from Squish loaded via MCP tools. Use `squish context` or `squish recall` to load relevant memories from past sessions."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_DIR}}/save-hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_DIR}}/precompact-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}