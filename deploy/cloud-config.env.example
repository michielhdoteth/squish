# Squish Universal - Cloud Deployment Configuration
# 
# Template for managed/cloud deployments
# Use with: AWS ECS, GCP Cloud Run, Kubernetes, etc.

# Environment variables for cloud deployment
# =========================================

# Required:
# DATABASE_URL=postgres://user:pass@host:5432/squish
# REDIS_URL=redis://host:6379
# SQUISH_API_KEY=your-secure-api-key

# Optional (with defaults):
# SQUISH_API_PORT=3456
# SQUISH_EMBEDDINGS_PROVIDER=openai  # or: ollama, local, none
# SQUISH_OPENAI_API_KEY=sk-...

# Health check endpoint
# GET http://localhost:3456/health

# API Endpoints
# ============
#
# Memories:
#   POST /memories          - Add memory
#   GET /memories?q=...    - Search memories  
#   GET /memories/:id       - Get memory
#   DELETE /memories/:id    - Delete memory
#
# Containers:
#   GET /containers         - List containers
#   POST /containers        - Create container
#
# Profile:
#   GET /profile/:container - Get user/project profile
#
# Sessions:
#   POST /sessions/ingest   - Ingest session data
#
# Health:
#   GET /health             - Health check

# MCP Server
# ==========
# Connect via stdio when running inside agent process
# Or via HTTP SSE at: http://host:3100/mcp (future)

# Connection Examples
# ==================

# cURL:
# curl -X POST http://localhost:3456/memories \
#   -H "Content-Type: application/json" \
#   -d '{"content": "Remember this", "container": "my-project"}'

# Python:
# import requests
# requests.post('http://localhost:3456/memories', json={
#   'content': 'User prefers dark mode',
#   'type': 'preference',
#   'container': 'my-project'
# })

# JavaScript/Node:
# await fetch('http://localhost:3456/memories', {
#   method: 'POST',
#   headers: { 'Content-Type': 'application/json' },
#   body: JSON.stringify({ content: '...', container: 'project' })
# })

# Hermes Agent (Python):
# import requests
# requests.post('http://squish:3456/memories', json={
#   'content': memory_content,
#   'type': 'learning',
#   'container': 'agent-session'
# })

# OpenClaw:
# squish remember "content" --project my-project

# OpenFang (WASM):
# Memory.remember({ content: "...", container: "default" })
